{
  "name": "@gpu-time/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "node --experimental-strip-types src/run.ts",
    "evaluate:model": "node --experimental-strip-types src/evaluate-model.ts",
    "evaluate:results": "node --experimental-strip-types src/evaluate-results.ts",
    "external": "node --experimental-strip-types src/external.ts",
    "size": "node --experimental-strip-types src/size.ts",
    "perf:browser": "node --experimental-strip-types src/perf.browser.ts",
    "report": "node --experimental-strip-types src/report.ts",
    "profile": "node --experimental-strip-types src/profile.ts",
    "trace": "node --experimental-strip-types src/trace.ts",
    "fetch:recognizers": "node --experimental-strip-types src/fetch-recognizers.ts",
    "test": "pnpm --filter gpu-time build && vitest run",
    "evaluate:english": "node --experimental-strip-types src/evaluate-english.ts",
    "evaluate:compatibility": "pnpm --filter gpu-time build && node --experimental-strip-types src/evaluate-compatibility.ts",
    "test:compatibility": "pnpm run evaluate:compatibility --floor",
    "test:recognizers": "pnpm --filter gpu-time build && node --experimental-strip-types src/external.ts --floor"
  },
  "dependencies": {
    "@breejs/later": "4.2.0",
    "@microsoft/recognizers-text-date-time": "1.3.2",
    "chrono-node": "2.10.1",
    "compromise": "14.16.0",
    "compromise-dates": "3.8.1",
    "gpu-time": "workspace:*",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
