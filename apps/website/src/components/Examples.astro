---
import { examples, highlight } from '../lib/demo';
---
<ul class="grid gap-2 sm:grid-cols-2">
  {examples.map(item => (
    <li>
      <button type="button" data-phrase={item.text} class="demo-example h-full w-full rounded-box border border-neutral-200 bg-neutral-50 px-3 py-2.5 text-left transition-colors hover:border-neutral-300 hover:bg-white">
        <span class="label block">{item.use}</span>
        <span class="mt-1.5 block text-[14px] leading-[1.6] tracking-[-0.1px]">{highlight(item.text).map(part => part.kind ? <span class={`hl hl-${part.kind}`}>{part.text}</span> : part.text)}</span>
      </button>
    </li>
  ))}
</ul>
