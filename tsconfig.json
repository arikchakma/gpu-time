{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "training/generate",
    "training/check-semantic.ts",
    "training/evaluate-semantic.ts",
    "training/diagnose-semantic.ts",
    "playground",
    "bench",
    "*.ts"
  ]
}
