<section class="mx-auto mt-10 max-w-[388px] text-center text-[14px] leading-[1.5] tracking-[-0.1px]" aria-label="Try gpu-time">
  <form id="demo-form" class="flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50/60 px-2 py-1 focus-within:border-neutral-400">
    <label for="demo-input" class="sr-only">Time expression</label>
    <input id="demo-input" name="expression" type="text" value="Every Monday from 8pm to 10pm" maxlength="500" required class="min-w-0 flex-1 bg-transparent px-1 py-1.5 outline-none" />
    <button id="demo-submit" class="inline-flex shrink-0 items-center justify-center rounded-full bg-black px-3 py-2 font-medium leading-none tracking-[-0.14px] text-white transition-colors hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50" type="submit">Parse</button>
  </form>
  <div id="demo-result" class="mt-4 text-left" aria-live="polite" aria-atomic="true">
    <p id="demo-status" class="text-[12px] text-neutral-500">Loading the example…</p>
    <ul id="demo-dates" class="mt-2 space-y-2"></ul>
  </div>
  <p id="demo-context" class="mt-4 text-[12px] leading-[1.5] text-neutral-500"></p>
  <noscript><p class="mt-3">Enable JavaScript to try the parser in your browser.</p></noscript>
</section>

<script>
  import { createParser } from '../../../src/index';

  const form = document.querySelector<HTMLFormElement>('#demo-form')!;
  const input = document.querySelector<HTMLInputElement>('#demo-input')!;
  const button = document.querySelector<HTMLButtonElement>('#demo-submit')!;
  const context = document.querySelector<HTMLParagraphElement>('#demo-context')!;
  const status = document.querySelector<HTMLParagraphElement>('#demo-status')!;
  const dates = document.querySelector<HTMLUListElement>('#demo-dates')!;
  const result = document.querySelector<HTMLDivElement>('#demo-result')!;
  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  const dateFormat = new Intl.DateTimeFormat(undefined, { timeZone, weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  const timeFormat = new Intl.DateTimeFormat(undefined, { timeZone, hour: 'numeric', minute: '2-digit' });
  const parser = createParser({ backend: 'cpu' });

  async function run() {
    button.disabled = true;
    input.disabled = true;
    result.setAttribute('aria-busy', 'true');
    status.textContent = 'Parsing…';
    dates.replaceChildren();
    const reference = new Date();
    context.textContent = `Relative to ${dateFormat.format(reference)} · ${timeZone}`;
    try {
      const parsed = await (await parser).parse(input.value.trim(), {
        reference: reference.toISOString(), timeZone, limit: 3,
      });
      status.textContent = parsed.diagnostics.length
        ? parsed.diagnostics.map(diagnostic => diagnostic.message).join(' ')
        : parsed.occurrences.length
          ? parsed.truncated ? 'Next 3 occurrences' : 'Result'
          : 'No dates found. Try a date or a time window.';
      for (const occurrence of parsed.occurrences) {
        const row = document.createElement('li');
        row.className = 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5';
        const date = document.createElement('span');
        const time = document.createElement('span');
        const start = new Date(occurrence.start);
        const end = occurrence.end ? new Date(occurrence.end) : start;
        date.textContent = dateFormat.format(start);
        time.className = 'text-neutral-500';
        if (!occurrence.end) {
          time.textContent = occurrence.allDay ? 'All day' : timeFormat.format(start);
        } else if (occurrence.allDay) {
          // Date-only ranges have an exclusive end at the next midnight.
          const lastDay = new Date(end.getTime() - 1);
          time.textContent = dateFormat.format(start) === dateFormat.format(lastDay)
            ? 'All day' : `Through ${dateFormat.format(lastDay)} · all day`;
        } else {
          const endDate = dateFormat.format(start) === dateFormat.format(end) ? '' : `${dateFormat.format(end)}, `;
          time.textContent = `${timeFormat.format(start)} – ${endDate}${timeFormat.format(end)}`;
        }
        row.append(date, time);
        dates.append(row);
      }
    } catch {
      status.textContent = 'The parser could not run. Please reload and try again.';
    } finally {
      button.disabled = false;
      input.disabled = false;
      result.setAttribute('aria-busy', 'false');
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (input.value.trim()) void run();
  });
  void run();
</script>
