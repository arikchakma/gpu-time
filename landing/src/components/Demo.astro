---
import { parse } from '../../../src/index';
import { example, format } from '../lib/demo';

// Ship a complete example with explicit context in the static HTML.
const reference = new Date();
const timeZone = 'UTC';
const initial = format(await parse(example, {
  reference: reference.toISOString(), timeZone, limit: 3,
}), reference, timeZone);
---
<section class="mx-auto mt-10 max-w-[388px] text-center text-[14px] leading-[1.5] tracking-[-0.1px]" aria-label="Try gpu-time">
  <form id="demo-form" class="flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50/60 px-2 py-1 focus-within:border-neutral-400">
    <label for="demo-input" class="sr-only">Time expression</label>
    <input id="demo-input" name="expression" type="text" value={example} maxlength="500" required class="min-w-0 flex-1 bg-transparent px-1 py-1.5 outline-none" />
    <button id="demo-submit" class="inline-flex shrink-0 items-center justify-center rounded-full bg-black px-3 py-2 font-medium leading-none tracking-[-0.14px] text-white transition-colors hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50" type="submit">Parse</button>
  </form>
  <div id="demo-result" class="mt-4 text-left mx-3" aria-live="polite" aria-atomic="true">
    <p id="demo-status" class="text-[12px] text-neutral-500">{initial.status}</p>
    <ul id="demo-dates" class="mt-2 space-y-2">
      {initial.rows.map(row => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
          <span>{row.date}</span><span class="text-neutral-500">{row.time}</span>
        </li>
      ))}
    </ul>
  </div>
  <p id="demo-context" class="mt-4 text-[12px] leading-[1.5] text-neutral-500">{initial.context}</p>
  <noscript><p class="mt-3">Enable JavaScript to try the parser in your browser.</p></noscript>
</section>

<script>
  import { format } from '../lib/demo';

  const form = document.querySelector<HTMLFormElement>('#demo-form')!;
  const input = document.querySelector<HTMLInputElement>('#demo-input')!;
  const button = document.querySelector<HTMLButtonElement>('#demo-submit')!;
  const context = document.querySelector<HTMLParagraphElement>('#demo-context')!;
  const status = document.querySelector<HTMLParagraphElement>('#demo-status')!;
  const dates = document.querySelector<HTMLUListElement>('#demo-dates')!;
  const result = document.querySelector<HTMLDivElement>('#demo-result')!;
  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  async function run() {
    button.disabled = true;
    input.disabled = true;
    result.setAttribute('aria-busy', 'true');
    const reference = new Date();
    try {
      const { parse } = await import('../../../src/index');
      const parsed = await parse(input.value.trim(), {
        reference: reference.toISOString(), timeZone, limit: 3,
      });
      const formatted = format(parsed, reference, timeZone);
      const fragment = document.createDocumentFragment();
      for (const row of formatted.rows) {
        const item = document.createElement('li');
        item.className = 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5';
        const date = document.createElement('span');
        const time = document.createElement('span');
        date.textContent = row.date;
        time.className = 'text-neutral-500';
        time.textContent = row.time;
        item.append(date, time);
        fragment.append(item);
      }
      dates.replaceChildren(fragment);
      status.textContent = formatted.status;
      context.textContent = formatted.context;
    } catch {
      dates.replaceChildren();
      status.textContent = 'The parser could not run. Please reload and try again.';
    } finally {
      button.disabled = false;
      input.disabled = false;
      result.setAttribute('aria-busy', 'false');
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (input.value.trim()) void run();
  });
</script>
